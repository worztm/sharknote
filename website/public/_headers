# Serve downloads as plain binaries with a 5-minute freshness window so the
# newest release shows up quickly while old pages still hit the edge cache.
/sharknote-setup.exe
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="sharknote-setup.exe"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# The update manifest must never be served from the edge cache: a stale
# cached copy makes freshly updated apps re-offer an already-installed
# version, and a missing-file SPA fallback would masquerade as JSON.
/latest.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

# Android APK: served as a plain download from this origin.
/sharknote-android.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="sharknote-0.4.3-android.apk"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300